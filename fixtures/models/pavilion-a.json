  "explanation": {
    "strategy": "A deep overhang and raised plinth keep the render out of the splash zone, a drained cavity lets it dry from behind, and the porous lime face is left to weather and host growth.",
    "why_elements": {
      "L-overhang": "Sheds rain away from the wall head.",
      "L-seat": "Sitting edge, held clear of the render so it can be replaced.",
      "L-clad": "Porous lime render left to weather and host moss and lichen.",
      "L-cavity": "Drained, ventilated gap behind the render, required in Vancouver.",
      "L-drip": "Base flashing that throws cavity water clear of the plinth.",
      "L-wall": "Timber frame and sheathing carrying the rainscreen.",
      "L-sep": "Stops moisture rising from the concrete into the frame.",
      "L-base": "Lifts the wall 200 mm out of the splash zone.",
      "L-drain": "Takes run-off away from the wall foot and limits splash.",
      "L-ground": "Planted soil beyond the drainage strip."
    }
  },
